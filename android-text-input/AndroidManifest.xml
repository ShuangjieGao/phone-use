<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.phoneuse.textinput" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33" />
    <application android:label="phone-use local text input" android:allowBackup="false">
        <service android:name=".EditorService" android:label="phone-use local text input"
            android:enabled="@bool/connection_available" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/editor_service" />
        </service>
    </application>
    <instrumentation android:name=".TextInput" android:targetPackage="io.github.phoneuse.textinput"
        android:label="phone-use display-scoped editor" />
</manifest>
